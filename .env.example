# Set independently in each DigitalOcean application. Do not commit real URLs
# until the production hostname and staging URL have been verified.
APP_URL=https://example.invalid

# Runtime traffic uses the environment's transaction pool. Migrations use a
# separate direct administrative connection. Both values are secrets and must
# be configured independently in staging and production.
DATABASE_URL=postgresql://app-user:password@pool.example.invalid:25061/app-pool?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://migration-user:password@database.example.invalid:25060/app_database?sslmode=require
